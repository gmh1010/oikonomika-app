{
  "name": "oikonomika-ui",
  "private": true,
  "description": "Build step: Tailwind CSS + self-hosted Inter font + Lucide icons -> app/static",
  "scripts": {
    "build": "tailwindcss -c tailwind.config.js -i input.css -o ../app/static/app.css --minify && node copy-assets.js",
    "watch": "tailwindcss -c tailwind.config.js -i input.css -o ../app/static/app.css --watch",
    "icons": "node make-icons.js"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/forms": "^0.5.11",
    "lucide-static": "^0.577.0",
    "tailwindcss": "^3.4.19"
  }
}
